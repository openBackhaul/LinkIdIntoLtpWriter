@startuml 022_WritingLinkIdIntoLtp
skinparam responseMessageBelowArrow true

title
RequestForAddingLinkToQueueCausesWritingLinkIdIntoLtp
end title

participant "External" as external
participant "LILW://v1/add-link-to-queue" as lilw_add
participant "LILW://v1/write-link-id-into-ltp" as lilw_write

external -> lilw_add: {linkId, mountNameA, mountNameB, {planning-data}} (apiKeyAuth)

activate lilw_add
lilw_add -> lilw_write: {linkId, mountNameA, mountNameB, {planning-data}} (apiKeyAuth)
lilw_write --> lilw_add: 200 OK

deactivate lilw_add
@enduml