@startuml 014_WritingLinkIdIntoLtpExternalLabel
skinparam responseMessageBelowArrow true

title
RequestForWritingLinkIdIntoLtpCausesWritingLinkIdIntoLtpExternalLabel
end title

participant "External" as external
participant "LILW://v1/write-link-id-into-ltp" as lilw_write
participant "MWDG://core-model-1-4:network-control-domain=live/\ncontrol-construct={mountName}/logical-termination-point={uuid}/ltp-augment-1-0:ltp-augment-pac/external-label" as Mwdg


external -> lilw_write: {linkId, mountNameA, mountNameB, {planning-data}} (apiKeyAuth)

activate lilw_write
lilw_write -> Mwdg: {MountName, LtpUUid, linkId} (apiKeyAuth)
Mwdg --> lilw_write: '204'
deactivate lilw_write
@enduml